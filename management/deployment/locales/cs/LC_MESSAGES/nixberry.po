msgstr "Výstupní adresář už existuje; export jej nepřepíše."

msgid "The owner marker must not be a link."
msgstr "Značka vlastníka nesmí být odkaz."

msgid "The plan changed hypervisor state."
msgstr "Plán změnil stav hypervizoru."

msgid "The plan includes erasing existing partitions; this only happens with --apply."
msgstr "Plán zahrnuje smazání existujících oddílů; provede se pouze s --apply."

msgid "The prebuilt image is missing."
msgstr "Chybí hotový obraz."

#, c-format
msgid "The prebuilt system disk is missing: %s"
msgstr "Chybí hotový systémový disk: %s"

msgid "The prepared ISO already exists; nothing will be overwritten."
msgstr "Připravené ISO už existuje; nic nepřepisuji."

msgid "The preview cannot prove whether files are used outside this directory."
msgstr "Použití mimo tento adresář nelze z náhledu prokázat."

msgid "The preview deletes nothing. A stopped VM or old file is not proof of disuse. Do not add shared disk and generation sizes as reclaimable space."
msgstr "Náhled nic nemaže. Vypnutí ani stáří neprokazuje nepoužívání. Velikosti sdílených disků a generací nesčítej jako uvolnitelné místo."

msgid "The Proxmox bridge does not exist."
msgstr "Proxmox bridge neexistuje."

msgid "The Proxmox configuration does not match the owner or hardware."
msgstr "Proxmox konfigurace neodpovídá vlastníkovi nebo hardwaru."

msgid "The Proxmox import path must not contain a comma."
msgstr "Cesta pro Proxmox import nesmí obsahovat čárku."

msgid "The Proxmox lab already exists; nothing will be overwritten or rebooted."
msgstr "Proxmox lab už existuje; nic nepřepisuji ani nerestartuji."

msgid "The Proxmox lab data resources are ready."
msgstr "Datové prostředky Proxmox labu jsou připravené."

msgid "The Proxmox lab has lab-vm storage, vmbr0 bridge and KVM ready."
msgstr "Proxmox lab má připravené úložiště lab-vm, bridge vmbr0 a KVM."

msgid "The Proxmox lab identity does not match the declaration."
msgstr "Identita Proxmox labu neodpovídá deklaraci."

msgid "The Proxmox storage is inactive."
msgstr "Proxmox úložiště není aktivní."

msgid "The Proxmox storage lacks space for the declared disk capacity and EFI."
msgstr "Proxmox úložiště nemá místo pro deklarovanou kapacitu disku a EFI."

msgid "The Proxmox system disk was changed outside the declared creation."
msgstr "Proxmox systémový disk byl změněn mimo deklarované vytvoření."

msgid "The Proxmox VM already exists."
msgstr "Proxmox VM už existuje."

msgid "The Proxmox VM disk is not a verified volume of this instance; refusing reset."
msgstr "Disk Proxmox VM není ověřený svazek této instance; reset odmítám."

msgid "The Proxmox VM has an additional disk or foreign medium; refusing reset."
msgstr "Proxmox VM má další disk nebo cizí médium; reset odmítám."

msgid "The Proxmox VM identity or node does not match."
msgstr "Identita nebo uzel Proxmox VM nesouhlasí."

msgid "The Proxmox VM is locked, protected or a template; refusing reset."
msgstr "Proxmox VM je zamčená, chráněná nebo je šablonou; reset odmítám."

msgid "The Proxmox VMID or name is already in use in the cluster."
msgstr "VMID nebo název Proxmox VM je obsazené v clusteru."

msgid "The reserved static address for the test NAT network is missing."
msgstr "Chybí vyhrazená statická adresa testovací NAT sítě."

msgid "The result does not contain exactly one image of the expected format."
msgstr "Ve výsledku není právě jeden obraz očekávaného formátu."

msgid "The root filesystem is not the installation tmpfs."
msgstr "Kořen není instalační tmpfs."

msgid "The root partition is not ext4."
msgstr "Kořenový oddíl není ext4."

msgid "The RPi hardware does not match the declared machine."
msgstr "Hardware RPi neodpovídá deklarovanému stroji."

msgid "The RPi network adapter does not match the declaration."
msgstr "Síťový adaptér RPi neodpovídá deklaraci."

#, python-brace-format
msgid "The running system does not match the recipe.\nExpected system: {system}"
msgstr "Běžící systém neodpovídá receptu.\nOčekávaný systém: {system}"

msgid "The running VM does not have the expected static address, prefix or default gateway."
msgstr "Běžící VM nemá očekávanou pevnou adresu, prefix nebo výchozí bránu."

msgid "The running VM is not using the expected DNS servers."
msgstr "Běžící VM nepoužívá očekávané DNS servery."

msgid "The saved VM declaration differs from the current one; nothing will be overwritten."
msgstr "Uložená deklarace VM neodpovídá aktuální; nic nepřepisuji."

msgid "The script contains a reserved input terminator."
msgstr "Skript obsahuje vyhrazenou koncovou značku vstupu."

msgid "The SSH forward did not start listening."
msgstr "SSH forward nezačal naslouchat."

msgid "The state after create does not match the method."
msgstr "Stav po create neodpovídá metodě."

msgid "The static network test did not change exactly one declaration to static configuration."
msgstr "Test pevné sítě nezměnil právě jednu deklaraci na statickou konfiguraci."

#, python-brace-format
msgid "The step exited with code {code}: {detail}"
msgstr "Krok skončil kódem {code}: {detail}"

msgid "The step timed out; resource state requires inspection."
msgstr "Časový limit kroku; stav prostředků vyžaduje kontrolu."

msgid "The storage is a reparse point."
msgstr "Úložiště je reparse point."

msgid "The storage is inactive."
msgstr "Úložiště není aktivní."

msgid "The storage path does not match the manifest."
msgstr "Cesta úložiště neodpovídá manifestu."

msgid "The storage path must not contain a symbolic link."
msgstr "Cesta úložiště nesmí obsahovat symbolický odkaz."

msgid "The system check did not return the expected result."
msgstr "Kontrola systému nevrátila očekávaný výsledek."

msgid "The system disk does not have the expected serial."
msgstr "Systémový disk nemá očekávaný serial."

msgid "The system disk does not match or an additional disk is attached."
msgstr "Nesouhlasí systémový disk nebo je připojen další disk."

msgid "The system is installed on disk, ready for shutdown and ISO detachment."
msgstr "Systém je nainstalovaný na disku; připravený k vypnutí a odpojení ISO."

msgid "The system profile does not match after installation."
