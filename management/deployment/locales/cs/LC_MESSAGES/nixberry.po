msgstr "Během přenosu se cíl změnil. Aktivace neproběhla; spusť update znovu."

msgid "The target declaration differs from the running CLI. Run the command again through the current nixberry launcher."
msgstr "Deklarace cíle se liší od spuštěného CLI. Spusť příkaz znovu přes aktuální spouštěč nixberry."

msgid "The target disk already exists in storage."
msgstr "Cílový disk již existuje v úložišti."

msgid "The target disk already exists. It will not be overwritten."
msgstr "Cílový disk již existuje. Příkaz jej nepřepíše."

msgid "The target disk already has partitions or child devices."
msgstr "Cílový disk již má oddíly nebo podřízená zařízení."

msgid "The target disk contains signatures."
msgstr "Cílový disk obsahuje signatury."

msgid "The target disk is mounted."
msgstr "Cílový disk je připojený."

msgid "The target disk is not vda."
msgstr "Cílový disk není vda."

msgid "The target disk is too small."
msgstr "Cílový disk je příliš malý."

msgid "The target does not have exactly one usable IPv4 address. Details: probe TARGET."
msgstr "Cíl nemá právě jednu použitelnou IPv4. Podrobnosti: probe CÍL."

msgid "The target identity matches the declaration."
msgstr "Identita cíle odpovídá deklaraci."

msgid "The target is not a block device."
msgstr "Cíl není blokové zařízení."

msgid "The target is not absent after cleanup."
msgstr "Po úklidu cíl není nepřítomný."

msgid "The target is not an unambiguous physical disk."
msgstr "Cíl není jednoznačný fyzický disk."

msgid "The target is not running; login is unavailable."
msgstr "Cíl neběží; přihlášení není dostupné."

#, python-brace-format
msgid "The target is not running: {value1}"
msgstr "Cíl neběží: {value1}"

msgid "The target or build did not return a valid system generation path."
msgstr "Cíl nebo sestavení nevrátilo platnou cestu systémové generace."

