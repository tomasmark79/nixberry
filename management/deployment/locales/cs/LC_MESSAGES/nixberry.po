msgstr "Libvirt VM nemá deklarovanou značku vlastníka."

msgid "The local manager currently supports Linux; use SSH for Windows."
msgstr "Místní správce nyní podporuje Linux; Windows používej přes SSH."

msgid "The LVM group uses another disk."
msgstr "LVM skupina používá další disk."

msgid "The MAC address already has a declaration in this network."
msgstr "MAC má v síti již existující deklaraci."

#, c-format
msgid "The MAC address is already used by %s."
msgstr "MAC je již použita strojem %s."

msgid "The MAC address is already used by another VM."
msgstr "MAC už používá jiná VM."

msgid "The managed installation ISO is missing."
