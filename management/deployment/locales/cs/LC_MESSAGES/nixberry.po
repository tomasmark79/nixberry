msgstr "Cíl: Proxmox lab {address}; připravení vyhrazeného datového disku a stagingu."

msgid "Test VM NVRAM path does not match."
msgstr "Nesouhlasí cesta NVRAM testovací VM."

msgid "The active and default systems differ; a reboot may start a different system."
msgstr "Aktivní a výchozí systém se liší; po restartu může naběhnout jiný systém."

msgid "The active and default systems match."
msgstr "Aktivní a výchozí systém odpovídají."

msgid "The active system is not the expected pinned system."
msgstr "Aktivní systém není očekávaný připnutý systém."

msgid "The actual image has a different format, capacity, backing image or internal snapshot; refusing reset."
msgstr "Skutečný obraz má jiný formát, kapacitu, podklad nebo interní snapshot; reset odmítám."

msgid "The adapter failed."
msgstr "Adaptér selhal."

msgid "The address is resolved from the declaration and live state; Hyper-V uses Windows as a jump host."
msgstr "Adresa se zjistí z deklarace a živého stavu; Hyper-V použije Windows jako jump host."

msgid "The backing image path is missing."
msgstr "Chybí cesta podkladového obrazu."

msgid "The boot configuration differs from the running system; a reboot is required."
msgstr "Bootovací konfigurace se liší od běžícího systému; je potřeba restart."

msgid "The boot configuration differs or cannot be compared; check whether a reboot is needed."
msgstr "Bootovací konfigurace se liší nebo ji nelze porovnat; prověř potřebu restartu."

msgid "The boot configuration matches."
msgstr "Bootovací konfigurace odpovídá."

msgid "The boot entry does not reference the kernel, initrd and system."
msgstr "Bootovací záznam neodkazuje na kernel, initrd a systém."

msgid "The build did not return exactly one image."
msgstr "Sestavení nevrátilo právě jeden obraz."

#, python-brace-format
msgid "The build result is missing the expected image: {value1}"
msgstr "Ve výsledku sestavení chybí očekávaný obraz: {value1}"

#, python-brace-format
msgid "The built installation ISO is missing: {path}"
msgstr "Chybí sestavené instalační ISO: {path}"

#, c-format
msgid "The built installation ISO is missing: %s"
msgstr "Chybí sestavené instalační ISO: %s"

msgid "The campaign does not support cleanup for this backend."
msgstr "Úklid tohoto backendu kampaň nepodporuje."

msgid "The case has retained resources; inspect its state first."
msgstr "Případ má zachované prostředky; nejprve je nutná kontrola stavu."

#, python-brace-format
msgid "The check failed: {value1}"
msgstr "Kontrola se nezdařila: {value1}"

msgid "The checksum did not detect the corrupted copy."
msgstr "Kontrolní součet nerozpoznal poškozenou kopii."

msgid "The command accepts at most one option."
msgstr "Příkaz přijímá nejvýše jednu volbu."

msgid "The configuration has both a file and a directory; keep only one definition."
msgstr "Konfigurace má současně soubor i adresář; ponech pouze jednu definici."

msgid "The corresponding offline export must pass first."
msgstr "Nejprve musí projít odpovídající offline export."

msgid "The data disk contains recognized data; nothing will be erased."
msgstr "Datový disk obsahuje rozpoznaná data; nic nemažu."

msgid "The data disk does not belong to the expected LVM group."
msgstr "Datový disk nepatří do očekávané LVM skupiny."

msgid "The data disk does not have the expected serial."
msgstr "Datový disk nemá očekávaný serial."

msgid "The data disk has partitions or other attached devices."
msgstr "Datový disk má oddíly nebo další připojená zařízení."

msgid "The data disk is mounted."
msgstr "Datový disk je připojený."

msgid "The declaration already exists; refusing to overwrite it."
msgstr "Deklarace už existuje; nepřepisuji ji."

msgid "The declared host is unavailable over verified SSH."
msgstr "Deklarovaný hostitel není dostupný přes ověřené SSH."

msgid "The declared IPv4 address is not enabled on the RPi."
msgstr "RPi nemá povolenou deklarovanou IPv4 adresu."

msgid "The declared VirtualBox bridge adapter does not exist."
msgstr "Deklarovaný VirtualBox bridge adaptér neexistuje."

msgid "The dedicated storageDirectory must be an existing absolute directory outside the drive root."
msgstr "Vyhrazený storageDirectory musí být existující absolutní adresář mimo kořen disku."

msgid "The default mode only verifies the plan. --apply creates a VM using the selected image or iso method."
msgstr "Výchozí režim jen ověří plán. --apply vytvoří VM podle zvolené metody image nebo iso."

msgid "The destination directory already exists; refusing to overwrite an existing or partial result."
msgstr "Adresář cíle už existuje; existující ani částečný výsledek nepřepisuji."

msgid "The direct SSH target does not match the declared VM architecture and hostname."
msgstr "Přímý SSH cíl neodpovídá deklarované architektuře a hostname VM."

msgid "The disk already contains child devices."
msgstr "Disk už obsahuje podřízená zařízení."

msgid "The disk already contains partitions."
msgstr "Disk už obsahuje oddíly."

msgid "The disk already contains signatures."
msgstr "Disk už obsahuje signatury."

msgid "The disk contains signatures."
msgstr "Disk obsahuje signatury."

msgid "The disk does not belong to the declared storage."
msgstr "Disk nepatří do deklarovaného úložiště."

msgid "The disk file still exists after removal."
msgstr "Soubor disku po odstranění stále existuje."

msgid "The disk has a backing image or unverified origin; refusing reset."
msgstr "Disk má podkladový obraz nebo neověřený původ; reset odmítám."

msgid "The disk has child devices other than regular partitions."
msgstr "Disk má podřízená zařízení jiná než běžné oddíly."

msgid "The disk is mounted."
msgstr "Disk je připojený."

msgid "The disk is shared with another VM."
msgstr "Disk je sdílený jinou VM."

msgid "The disk is too small."
msgstr "Disk je příliš malý."

msgid "The disk is used by another VM or snapshot; refusing reset."
msgstr "Disk používá jiná VM nebo snapshot; reset odmítám."

msgid "The disk listing is not a tree; partitions cannot be assigned safely."
msgstr "Výpis disků není stromový; nelze bezpečně přiřadit oddíly."

msgid "The disk name does not match the test VM."
msgstr "Název disku neodpovídá testovací VM."

msgid "The disk or environment does not match the installation; this may be an installation ISO or recovery SD."
msgstr "Disk nebo prostředí neodpovídá instalaci; může jít o instalační ISO či obnovovací SD."

msgid "The disk or NVRAM is missing, is a link or is a shared file; refusing reset."
msgstr "Disk nebo NVRAM chybí, je odkazem nebo sdíleným souborem; reset odmítám."

msgid "The disk or NVRAM is shared with another VM; refusing writes or removal."
msgstr "Disk nebo NVRAM sdílí jiná VM; odmítám zápis nebo odstranění."

msgid "The disk record must not be a link."
msgstr "Záznam disku nesmí být odkaz."

msgid "The EFI bootloader is missing."
msgstr "Chybí EFI zavaděč."

msgid "The evaluated test VM network does not match the specified values."
msgstr "Vyhodnocená síť testovací VM neodpovídá zadaným hodnotám."

msgid "The export does not match the selected platform and method."
msgstr "Export neodpovídá zvolené platformě a metodě."

msgid "The export overwrote an existing bundle."
msgstr "Export přepsal existující balíček."

msgid "The export preview wrote a bundle."
msgstr "Náhled exportu zapsal balíček."

msgid "The exported disk has an incorrect format or capacity."
msgstr "Exportovaný disk má nesprávný formát nebo kapacitu."

msgid "The exported lock does not match the manifest."
msgstr "Exportovaný lock neodpovídá manifestu."

msgid "The generated MAC conflicts with an existing one; run the command again."
msgstr "Vygenerovaná MAC koliduje; spusť příkaz znovu."

msgid "The guest address is outside the expected network."
msgstr "Adresa hosta není v očekávané síti."

msgid "The guest address must differ from the Windows host address."
msgstr "Adresa guest systému nesmí být adresa Windows hostitele."

msgid "The guest did not boot through UEFI."
msgstr "Host nenaběhl přes UEFI."

msgid "The guest is not a Raspberry Pi 5."
msgstr "Host není Raspberry Pi 5."

msgid "The guest is not an installation environment."
msgstr "Host není instalační prostředí."

msgid "The guest is not ARM64."
msgstr "Host není ARM64."

msgid "The guest is not running the prepared installation environment."
msgstr "Host neběží z připraveného instalačního prostředí."

msgid "The guest is not running the prepared installation environment. Only --stage is available."
msgstr "Host neběží z připraveného instalačního prostředí. Lze použít pouze --stage."

msgid "The guest is not x86_64."
msgstr "Host není x86_64."

msgid "The handed-off VM did not start verified SSH within the timeout."
msgstr "Předaná VM nespustila ověřené SSH v časovém limitu."

msgid "The handed-off VM has no verified address."
msgstr "Předaná VM nemá ověřenou adresu."

msgid "The handoff bundle's working declaration must not be a symbolic link."
msgstr "Pracovní deklarace předaného balíčku nesmí být symbolický odkaz."

msgid "The handoff target already exists; import is not allowed."
msgstr "Cíl pro předání už existuje; import se nepovoluje."

#, python-brace-format
msgid "The host adapter did not return JSON: {value1}"
msgstr "Hostitelský adaptér nevrátil JSON: {value1}"

msgid "The host did not respond."
msgstr "Hostitel neodpověděl."

msgid "The host did not return the state of all requested VMs."
msgstr "Hostitel nevrátil stav všech požadovaných VM."

msgid "The host does not match the selected backend."
msgstr "Hostitel neodpovídá zvolenému backendu."

msgid "The host hostname does not match the declaration."
msgstr "Hostname hostitele neodpovídá deklaraci."

msgid "The host operating system does not match the declaration."
msgstr "Operační systém hostitele neodpovídá deklaraci."

msgid "The Hyper-V operation timed out. Check the target's status and probe before retrying."
msgstr "Operace Hyper-V překročila časový limit. Před opakováním zkontroluj status a probe cíle."

msgid "The Hyper-V VM does not have the declared owner."
msgstr "Hyper-V VM nemá deklarovaného vlastníka."

msgid "The Hyper-V VM does not match the declared adapter and generation."
msgstr "Hyper-V VM neodpovídá deklaraci adaptéru a generace."

msgid "The hypervisor tool path is missing."
msgstr "Chybí cesta k nástroji hypervizoru."

msgid "The image method must not have an installation ISO attached."
msgstr "Metoda image nesmí mít připojené instalační ISO."

#, python-brace-format
msgid "The image root must be a directory: {value1}"
msgstr "Kořen obrazů musí být adresář: {value1}"

msgid "The image SHA256 is missing."
msgstr "Chybí SHA256 obrazu."

msgid "The image transfer is incomplete or corrupted."
msgstr "Přenos obrazu je neúplný nebo poškozený."

#, python-brace-format
msgid "The installation environment is not ready: {value1}"
msgstr "Instalační prostředí není připravené: {value1}"

msgid "The installation ISO is not attached."
msgstr "Instalační ISO není připojené."

msgid "The installation ISO is unreachable; leaving the VM unchanged."
msgstr "Instalační ISO není dosažitelné; VM ponechávám beze změny."

msgid "The installation ISO must not be a symbolic link."
msgstr "Instalační ISO nesmí být symbolický odkaz."

msgid "The installation media contains different pinned outputs."
msgstr "Instalační médium obsahuje jiné připnuté výstupy."

msgid "The installation VM did not boot through UEFI."
msgstr "Instalační VM neběží přes UEFI."

#, python-brace-format
msgid "The installer is running. The password is in {path}; verify the installation result separately."
msgstr "Instalátor běží. Heslo je v souboru {path}; výsledek instalace ještě ověř samostatně."

msgid "The ISO bundle does not include installation instructions."
msgstr "ISO balíček neobsahuje instalační postup."

msgid "The ISO is not attached."
msgstr "ISO není připojené."

msgid "The ISO is still attached."
msgstr "ISO zůstalo připojené."

msgid "The iso method creates a new VM with a blank disk; install verifies the installation environment, writes the system and detaches the ISO."
msgstr "Metoda iso vytvoří novou VM s prázdným diskem; install ověří instalační prostředí, zapíše systém a odpojí ISO."

msgid "The kernel is not loaded."
msgstr "Kernel není načtený."

msgid "The kernel was not unloaded."
msgstr "Kernel se neuvolnil."

msgid "The kernel, initrd and boot parameters match the running system; no reboot is needed."
msgstr "Kernel, initrd a parametry startu odpovídají běžícímu systému; restart není potřeba."

#, python-brace-format
msgid "The lab disk already exists: {path}"
msgstr "Disk labu už existuje: {path}"

msgid "The lab network already exists; partial state requires inspection."
msgstr "Síť labu už existuje; částečný stav vyžaduje kontrolu."

msgid "The lab requires at least 100 GiB of free storage."
msgstr "Lab vyžaduje alespoň 100 GiB volné kapacity úložiště."

msgid "The lab subnet overlaps an existing route."
msgstr "Podsíť labu koliduje s existující trasou."

msgid "The libvirt VM identity does not match the declaration."
msgstr "Identita libvirt VM neodpovídá deklaraci."

msgid "The libvirt VM identity does not match the dedicated Proxmox lab."
msgstr "Identita libvirt VM neodpovídá vlastnímu Proxmox labu."

