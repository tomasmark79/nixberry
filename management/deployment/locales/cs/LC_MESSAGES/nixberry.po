msgid "The method differs from the created VM; use the original --method."
msgstr "Metoda neodpovídá vytvořené VM; použij původní --method."

msgid "The network has no NAT."
msgstr "Síť nemá NAT."

msgid "The network is inactive."
msgstr "Síť není aktivní."

msgid "The new test target already exists; it will not be taken over."
msgstr "Nový testovací cíl už existuje; nic nepřebírám."

#, c-format
msgid "The NixBerry recipe is incomplete or unavailable: %s"
msgstr "Recept NixBerry není úplný nebo dostupný: %s"

