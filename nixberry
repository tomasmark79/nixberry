#!/usr/bin/env bash
# Direct recipe management works from any working directory.
set -euo pipefail
launcher_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
source "$launcher_dir/management/deployment/shell-path.sh"
recipe=$(_nixberry_recipe_dir "$launcher_dir")
export NIXBERRY_RECIPE="$recipe"
exec nix run --no-write-lock-file "path:$recipe#nixberry" -- "$@"
